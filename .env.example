# DailyGreen Production Environment Configuration Template
# COPY TO .env BEFORE RUNNING. NEVER COMMIT REAL CREDENTIALS.

# Server Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Safety Invariant Flags (Mandatory Defaults)
DRY_RUN=true
ALLOW_LIVE_MUTATIONS=false
MAX_WORKERS=1
DAILYGREEN_ENABLED=false

# Timezone Configuration (Default: Asia/Tashkent UTC+5)
DAILYGREEN_TIMEZONE=Asia/Tashkent

# Google Gemini Intelligence (Optional; falls back gracefully to deterministic heuristics)
# Server-side environment variable only. Never exposed to browser bundles.
GEMINI_API_KEY=

# GitHub Read-Only Probing (Optional; session-only in memory)
GITHUB_TOKEN=

# Persistent Storage Root
DAILYGREEN_DATA_DIR=.dailygreen-data