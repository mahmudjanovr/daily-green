# DailyGreen Environment Configuration Example
# Copy this file to .env for local testing (NEVER commit your real .env file)

# Global kill switch (true / false)
DAILYGREEN_ENABLED=true

# Dry-run mode: when true, tasks are validated but no branches/PRs are pushed to GitHub
DRY_RUN=true

# GitHub Token (for local manual runs; in GitHub Actions, pass secrets or GitHub App tokens)
# Required scopes for delivery: 'contents: write', 'pull_requests: write', 'issues: read'
GITHUB_TOKEN=

# Optional: Path to custom repository allowlist configuration
# DAILYGREEN_REPOS_CONFIG=config/repos.yml

# Optional: Path to custom security policy configuration
# DAILYGREEN_POLICY_CONFIG=config/policy.yml

# AI Provider Configuration ("mock" or "gemini")
DAILYGREEN_AI_PROVIDER=mock
# When using gemini:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# --- Opt-in Live Integration Testing (Safe Disposable Test Repositories Only) ---
# RUN_LIVE_GITHUB_TEST=0
# LIVE_GITHUB_TEST_REPO=disposable-org/disposable-sandbox-repo
# LIVE_GITHUB_TOKEN=
# ALLOW_LIVE_MUTATIONS=0
